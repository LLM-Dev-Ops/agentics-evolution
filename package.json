{
  "name": "agentics-evolution",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20 <21" },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-source.mjs",
    "test": "node --test test/*.test.mjs",
    "conformance": "node scripts/conformance.mjs",
    "evidence:sbom": "cyclonedx-npm --output-file reports/sbom.cdx.json --output-format JSON --spec-version 1.6",
    "verify:prompt-01": "npm run lint && npm run typecheck && npm test && npm run conformance && npm run evidence:sbom"
  },
  "dependencies": {
    "@claude-flow/cli": "3.38.0",
    "@metaharness/darwin": "0.9.1",
    "@metaharness/flywheel": "0.1.10",
    "@metaharness/harness": "0.2.0",
    "@metaharness/host-claude-code": "0.1.2",
    "@metaharness/host-codex": "0.1.2",
    "@metaharness/kernel": "0.1.3",
    "@metaharness/redblue": "0.1.4",
    "@metaharness/router": "0.4.0",
    "@metaharness/turn-credit": "0.1.0",
    "claude-flow": "3.38.0",
    "metaharness": "0.4.5",
    "ruflo": "3.38.0",
    "ruvector": "0.2.41"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@types/node": "20.19.17",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  }
}
